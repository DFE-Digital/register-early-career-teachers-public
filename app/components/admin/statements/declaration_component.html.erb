<div class="finance-panel govuk-!-margin-top-5 govuk-!-margin-bottom-5">
  <%= govuk_table do |table|

    table.with_caption(text: "Declarations summary", size: "m")

    table.with_head do |head|
      head.with_row do |row|
        row.with_cell(header: true) { "" }
        presented_calculators.each do |declaration_column|
          row.with_cell(header: true, numeric: true) { declaration_column.header }
        end
      end
    end

    table.with_body do |body|
      declaration_types.each do |type|
        body.with_row do |row|
          row.with_cell { type.capitalize }
          presented_calculators.each do |declaration_column|
            row.with_cell(numeric: true) { declaration_column.count_for(type) }
          end
        end
      end

      body.with_row do |row|
        row.with_cell { "Clawbacks" }
        presented_calculators.each do |declaration_column|
          row.with_cell(numeric: true) { declaration_column.clawbacks_count }
        end
      end

      body.with_row do |row|
        row.with_cell { "Voided" }
        presented_calculators.each do |declaration_column|
          row.with_cell(numeric: true) { declaration_column.voided_count }
        end
      end
    end
  end %>

  <% if statement.output_fee? %>
    <p class="govuk-body-s govuk-!-text-align-right govuk-!-display-none-print">
      <%= govuk_link_to "Download declarations (CSV)", declarations_export_admin_finance_statement_path(statement, format: :csv) %>
    </p>
  <% end %>
</div>
