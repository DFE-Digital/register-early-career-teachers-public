<% page_data(
     title: "Change client details",
     error: @client.errors.any?,
     breadcrumbs: { "API clients" => admin_api_clients_path, @client.name_in_database => admin_api_client_path(@client), "Change client details" => nil }
   ) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @client, url: admin_api_client_path(@client) do |f| %>
      <%= content_for(:error_summary) { f.govuk_error_summary } %>

      <%= render "fields", form: f %>

      <div class="govuk-button-group">
        <%= f.govuk_submit "Save changes" %>
        <%= govuk_link_to "Cancel", admin_api_client_path(@client) %>
      </div>
    <% end %>
  </div>
</div>
