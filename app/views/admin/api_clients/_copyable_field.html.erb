<div class="govuk-form-group" data-controller="clipboard">
  <%= label_tag id, label, class: "govuk-label govuk-label--s" %>

  <div class="govuk-input__wrapper">
    <%= text_field_tag id,
          value,
          class: "govuk-input govuk-input--extra-letter-spacing",
          readonly: true,
          spellcheck: false,
          data: { clipboard_target: "source" } %>

    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2" data-clipboard-target="button" data-action="clipboard#copy" hidden>
      Copy<span class="govuk-visually-hidden"> <%= label.downcase_first %></span>
    </button>
  </div>

  <span class="govuk-visually-hidden" role="status" data-clipboard-target="status"></span>
</div>
