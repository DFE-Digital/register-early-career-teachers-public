<% page_data(
  title: "Add partnership",
  backlink_href: @wizard.previous_step_path
) %>

<p class="govuk-body">You want to add this partnership:</p>

<%= govuk_summary_list do |list| %>
  <%= list.with_row do |row| %>
    <%= row.with_key { "School" } %>
    <%= row.with_value { @wizard.school.name } %>
  <% end %>

  <% @review.partnership_details.each do |answer| %>
    <%= list.with_row do |row| %>
      <%= row.with_key { answer.label } %>
      <%= row.with_value { answer.formatted_value } %>
    <% end %>
  <% end %>
<% end %>

<%= form_with(
  model: @wizard.current_step,
  url: @wizard.current_step_path,
  scope: @wizard.current_step_name
) do |f| %>
  <%= f.govuk_submit "Confirm" %>
<% end %>

<p class="govuk-body">
  <%= govuk_link_to(
    "Cancel and go back to #{@wizard.school.name}",
    admin_school_partnerships_path(@wizard.school.urn)
  ) %>
</p>
