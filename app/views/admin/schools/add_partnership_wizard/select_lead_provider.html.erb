<%
  title = "Select the lead provider for #{@wizard.selected_contract_period.year}"

  page_data(
    title:,
    header: nil,
    error: @wizard.current_step.errors.present?,
    backlink_href: @wizard.previous_step_path
  )
%>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(model: @wizard.current_step, url: @wizard.current_step_path) do |f| %>
      <%= content_for(:error_summary) { f.govuk_error_summary } %>

      <%= f.govuk_radio_buttons_fieldset(
        :framework_agreement_id,
        legend: { text: title, size: "l", tag: "h1" }
      ) do %>
        <% @wizard.framework_agreements.each_with_index do |framework_agreement, index| %>
          <%= f.govuk_radio_button(
            :framework_agreement_id,
            framework_agreement.id,
            label: { text: framework_agreement.lead_provider.name },
            link_errors: index.zero?
          ) %>
        <% end %>
      <% end %>

      <%= f.govuk_submit "Continue" %>
    <% end %>
  </div>
</div>
