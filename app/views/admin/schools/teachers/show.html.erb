<% page_data(
  title: @school.name,
  caption: "URN: #{@school.urn}",
  caption_size: "xl",
  header_size: "xl",
  breadcrumbs: @breadcrumbs
) %>

<%= render 'admin/schools/impersonate_button' %>

<%= render Navigation::SecondaryNavigationComponent.new(
  items: @navigation_items
) %>

<h2 class="govuk-heading-m">Teachers</h2>

<% if @has_current_teachers %>
  <%= render Admin::Teachers::SearchComponent.new(
    form_url: admin_school_teachers_path(@school.urn),
    filter_params: params
  ) %>

  <% if @teacher_rows.any? %>
    <%= render Admin::Teachers::TableComponent.new(
      rows: @teacher_rows,
      teacher_path: ->(teacher_row) { admin_teacher_path(teacher_row.teacher_id) }
    ) %>
  <% else %>
    <p class="govuk-body">There are no teachers that match your search.</p>
  <% end %>
<% else %>
  <p class="govuk-body">No teachers found at this school.</p>
<% end %>
