<% page_data(title: "Induction platforms", breadcrumbs: @breadcrumbs) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <%= govuk_table do |table|
      table.with_head do |head|
        head.with_row { |row| row.with_cell(text: "Induction platform") }
      end

      table.with_body do |body|
        @induction_platforms.each do |induction_platform|
          body.with_row do |row|
            row.with_cell { govuk_link_to(induction_platform.name, admin_induction_platform_path(induction_platform), no_visited_state: true) }
          end
        end
      end
    end %>
  </div>
</div>
