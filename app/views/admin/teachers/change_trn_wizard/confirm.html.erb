<% page_data(
  title: "Confirm change of TRN for #{@wizard.teacher_name}",
  error: @wizard.current_step.errors.present?,
  backlink_href: @wizard.previous_step_path
) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <p class="govuk-body">This new TRN does not exist in the service.</p>

    <p class="govuk-body">This record will use the new TRN.</p>

    <p class="govuk-body">
      The deactivated TRN will be deleted from this service.
    </p>

    <%= govuk_summary_list do |summary_list| %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: "Current TRN") %>
        <% row.with_value(text: @teacher.trn) %>
      <% end %>

      <% summary_list.with_row do |row| %>
        <% row.with_key(text: "New TRN") %>
        <% row.with_value(text: @wizard.store.trn) %>
      <% end %>

      <% summary_list.with_row do |row| %>
        <% row.with_key(text: "Name from TRS") %>
        <% row.with_value(text: [
          @wizard.store.trs_first_name,
          @wizard.store.trs_last_name
        ].compact.join(" ")) %>
      <% end %>
    <% end %>

    <%= form_with(model: @wizard.current_step, url: @wizard.current_step_path) do |form| %>
      <%= content_for(:error_summary) { form.govuk_error_summary } %>
      <%= form.hidden_field :expected_trn, value: @wizard.store.trn %>

      <%= form.govuk_check_boxes_fieldset :confirmed, multiple: false, legend: nil do %>
        <%= form.govuk_check_box(
          :confirmed,
          "1",
          "0",
          link_errors: true,
          multiple: false,
          label: { text: "I confirm I want to change this teacher’s TRN" }
        ) %>
      <% end %>

      <%= govuk_warning_text do %>
        This action cannot be undone.
      <% end %>

      <%= form.govuk_submit "Confirm", warning: true %>
    <% end %>

    <p class="govuk-body">
      <%= govuk_link_to(
        "Cancel and go back to #{@wizard.teacher_name}",
        admin_teacher_path(@teacher),
        no_visited_state: true
      ) %>
    </p>
  </div>
</div>
