<% page_data(
  title: "Records merged",
  header: false
) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= govuk_panel(title_text: "Records merged") %>

    <p class="govuk-body">
      The record with the TRN <strong><%= @wizard.store.old_trn %></strong>
      has been merged into the record with the TRN
      <strong><%= @wizard.store.trn %></strong>.
    </p>

    <p class="govuk-body">
      The record with the TRN <strong><%= @wizard.store.old_trn %></strong>
      has been deleted with reason <code>teacher_record_merged</code>.
    </p>

    <h2 class="govuk-heading-m">What you need to do now</h2>

    <p class="govuk-body">
      Contact relevant lead providers to let them know about this merge.
    </p>

    <p class="govuk-body">
      <%= govuk_link_to "Back to teachers", admin_teachers_path %>
    </p>
  </div>
</div>
