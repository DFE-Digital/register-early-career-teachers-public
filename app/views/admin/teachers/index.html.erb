<% page_data(title: "Teachers") %>

<%= render Admin::Teachers::SearchComponent.new(
  form_url: admin_teachers_path,
  filter_params: params
) %>

<% if @teacher_rows.any? %>
  <%= render Admin::Teachers::TableComponent.new(
    rows: @teacher_rows,
    teacher_path: ->(teacher_row) { admin_teacher_path(teacher_row.teacher_id, admin_teacher_index_params) }
  ) %>
<% else %>
  <p class="govuk-body">There are no teachers that match your search.</p>
<% end %>


<%= govuk_button_link_to("Import a record from TRS", new_admin_import_ect_find_path, secondary: true) %>

<%= render Shared::PaginationSummaryComponent.new(pagy: @pagy, record_name: "teachers") %>
