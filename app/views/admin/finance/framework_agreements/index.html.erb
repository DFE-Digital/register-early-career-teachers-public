<% page_data(title: "Lead providers for #{@contract_period.year}", breadcrumbs: @breadcrumbs) %>

<p class="govuk-body">
  These lead providers are active for the <%= @contract_period.year %> contract period
  (<%= @contract_period.started_on.to_fs(:govuk) %> to <%= @contract_period.finished_on.to_fs(:govuk) %>).
</p>

<% unless @editable %>
  <p class="govuk-hint">This contract period has started, so lead provider framework agreements are no longer editable.</p>
<% end %>

<% if @framework_agreements.none? %>
  <p class='govuk-body'>No lead provider framework agreements for <%= @contract_period.year %></p>
<% else %>
  <%= govuk_table do |table| %>
    <% table.with_head do |head| %>
      <% head.with_row do |row| %>
        <% row.with_cell(text: "Lead provider") %>
        <% row.with_cell(text: "Contracts") %>
        <% row.with_cell(text: "Statements") %>
        <% row.with_cell(text: "Delivery partners") %>
        <% row.with_cell(text: "Bands") %>
        <% row.with_cell(text: "") if @editable %>
      <% end %>
    <% end %>
    <% table.with_body do |body| %>
      <% @framework_agreements.each do |framework_agreement| %>
        <% body.with_row do |row| %>
          <% row.with_cell(text: framework_agreement.lead_provider.name) %>
          <% row.with_cell do %>
            <%= govuk_link_to(pluralize(framework_agreement.contracts.size, "contract"), admin_contract_period_framework_agreement_contracts_path(@contract_period, framework_agreement), visually_hidden_suffix: "for #{framework_agreement.lead_provider.name}") %>
          <% end %>
          <% row.with_cell do %>
            <%= govuk_link_to(pluralize(framework_agreement.statements.size, "statement"), admin_contract_period_framework_agreement_statements_path(@contract_period, framework_agreement), visually_hidden_suffix: "for #{framework_agreement.lead_provider.name}") %>
          <% end %>
          <% row.with_cell do %>
            <%= govuk_link_to(pluralize(framework_agreement.delivery_partners.size, "delivery partner"), admin_contract_period_framework_agreement_lead_provider_delivery_partnerships_path(@contract_period, framework_agreement), visually_hidden_suffix: "for #{framework_agreement.lead_provider.name}") %>
          <% end %>
          <% row.with_cell do %>
            <%= govuk_link_to(pluralize(framework_agreement.bands.size, "band"), admin_contract_period_framework_agreement_bands_path(@contract_period, framework_agreement), visually_hidden_suffix: "for #{framework_agreement.lead_provider.name}") %>
          <% end %>
          <% if @editable %>
            <% row.with_cell do %>
              <%= govuk_button_to "Remove",
                    admin_contract_period_framework_agreement_path(@contract_period, framework_agreement),
                    method: :delete,
                    secondary: true,
                    visually_hidden_suffix: framework_agreement.lead_provider.name,
                    class: "govuk-!-margin-bottom-0" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @editable %>
  <div class="govuk-!-text-align-right">
    <%= govuk_button_link_to "Add a lead provider",
          new_admin_contract_period_framework_agreement_path(@contract_period) %>
  </div>
<% end %>
