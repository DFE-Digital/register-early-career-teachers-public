<%
  page_data(title: "Change capacity of #{label_for(band: @band)}",
            breadcrumbs: @breadcrumbs,
            error: @band.errors.present?,
            backlink_href: admin_contract_period_active_lead_provider_bands_path(@active_lead_provider.contract_period, @active_lead_provider))
%>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @band,
                   url: admin_contract_period_active_lead_provider_band_path(@active_lead_provider.contract_period, @active_lead_provider, @band),
                   method: :put do |f| %>
      <%= content_for(:error_summary) { f.govuk_error_summary } %>
      <%= f.govuk_number_field(:capacity, width: "one-quarter") %>
      <%= f.govuk_submit "Save" %>
    <% end %>
  </div>
</div>
