<% page_data(title: "Bands", breadcrumbs: @breadcrumbs) %>

<p class="govuk-body">
  Bands for <%= @active_lead_provider.lead_provider_name %> in the <%= @active_lead_provider.contract_period_year %> contract period.
</p>

<% if @bands.none? %>
  <p class="govuk-body">No bands found</p>
<% else %>
  <%= govuk_table do |table| %>
    <% table.with_head do |head| %>
      <% head.with_row do |row| %>
        <% row.with_cell(text: "Band") %>
        <% row.with_cell(text: "Capacity") %>
        <% row.with_cell(text: "Declaration range") %>
        <% row.with_cell(text: "") %>
      <% end %>
    <% end %>
    <% table.with_body do |body| %>
      <% @bands.each do |band| %>
        <% body.with_row do |row| %>
          <% row.with_cell(text: band_label(band:)) %>
          <% row.with_cell(text: band.capacity) %>
          <% row.with_cell(text: band_capacity_description(band:)) %>
          <% row.with_cell(numeric: true) do %>
            <div class="govuk-button-group govuk-!-margin-bottom-0">
              <% if band.editable? %>
                <%= govuk_link_to(
                  "Change",
                  edit_admin_contract_period_active_lead_provider_band_path(@active_lead_provider.contract_period, @active_lead_provider, band),
                  secondary: true,
                  no_visited_state: true,
                  visually_hidden_suffix: band_label(band:),
                  class: "govuk-!-margin-bottom-0")
                %>
              <% end %>
              <% if band.deletable? %>
                <%= govuk_button_to(
                  "Delete",
                  admin_contract_period_active_lead_provider_band_path(@active_lead_provider.contract_period, @active_lead_provider, band),
                  method: :delete,
                  warning: true,
                  visually_hidden_suffix: band_label(band:),
                  class: "govuk-!-margin-bottom-0")
                %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @active_lead_provider.bands_can_be_added_and_removed? %>
  <%= govuk_button_link_to "Add band", new_admin_contract_period_active_lead_provider_band_path(@active_lead_provider.contract_period, @active_lead_provider) %>
<% end %>
