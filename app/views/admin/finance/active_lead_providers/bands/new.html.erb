<%
    page_data(
      title: "Add band to #{@framework_agreement.lead_provider_name}",
      breadcrumbs: @breadcrumbs,
      error: @band.errors.present?,
      backlink_href: admin_contract_period_active_lead_provider_bands_path(@framework_agreement.contract_period, @framework_agreement))
%>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @band,
                   url: admin_contract_period_active_lead_provider_bands_path(@framework_agreement.contract_period, @framework_agreement),
                   method: :post do |f| %>
      <%= content_for(:error_summary) { f.govuk_error_summary } %>
      <%= f.govuk_number_field(:capacity, width: "one-quarter") %>
      <%= f.govuk_submit "Add new band" %>
    <% end %>
  </div>
</div>
