<% page_data(
    title: "Enter data fixes in CSV format",
    header: false,
    error: @wizard.current_step.errors.any?,
    backlink_href: admin_tools_path,
) %>

<%= form_with(
      model: @wizard.current_step,
      url: @wizard.current_step_path,
      scope: @wizard.current_step_name
    ) do |form| %>
  <%= content_for(:error_summary) do %>
    <%= form.govuk_error_summary(presenter: @wizard.error_presenter) %>
  <% end %>

  <%= form.govuk_text_area(
        :csv_string,
        label: { text: "Enter data fixes in CSV format", tag: "h1", size: "l" },
        hint: { text: "Include a header row: #{Admin::DataFixesWizard::Operations::ParseCSV::HEADER_ROW.join(',')}" },
        rows: 10
      ) %>

  <%= form.govuk_submit "Continue" %>
<% end %>
