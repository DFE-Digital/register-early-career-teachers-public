<% page_data(
    title: "Preview the proposed data fix",
    error: @wizard.current_step.errors.any?,
    backlink_href: @wizard.previous_step_path
) %>

<%= form_with(model: @wizard.current_step, url: @wizard.current_step_path) do |form| %>
  <%= content_for(:error_summary) { form.govuk_error_summary(presenter: @wizard.error_presenter) } %>

  <%= render Admin::DataFixes::ParsedCSVComponent.new(@wizard.current_step.parsed_rows) %>

  <%= form.govuk_submit "Preview" %>
<% end %>
