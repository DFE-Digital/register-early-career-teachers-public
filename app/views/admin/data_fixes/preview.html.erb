<% page_data(
    title: "Check the parsed CSV",
    error: @wizard.current_step.errors.any?,
    backlink_href: @wizard.previous_step_path
) %>

<%= form_with(
      model: @wizard.current_step,
      url: @wizard.current_step_path,
      scope: @wizard.current_step_name
    ) do |form| %>
  <%= content_for(:error_summary) do %>
    <%= form.govuk_error_summary(presenter: @wizard.error_presenter) %>
  <% end %>

  <%= render Admin::DataFixes::ParsedCSVComponent.new(@wizard.current_step.parsed_rows) %>

  <%= form.govuk_submit "Continue" %>
<% end %>
