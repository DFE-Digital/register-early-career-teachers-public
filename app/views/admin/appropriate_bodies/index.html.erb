<% page_data(title: "Appropriate bodies", breadcrumbs: @breadcrumbs) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <p class="govuk-body">
      <%= govuk_link_to("View all bulk uploads", admin_batches_path) %>
    </p>

    <%= form_with method: :get do |f| %>
      <%=
        f.govuk_text_field(
          "q",
          value: params[:q],
          label: { text: "Search for an appropriate body", size: "s" }
        )
      %>

      <%= f.govuk_check_boxes_fieldset("include_de_designated", legend: nil, multiple: false) do %>
        <%=
          f.govuk_check_box(
            "include_de_designated",
            "1",
            multiple: false,
            checked: @include_de_designated,
            include_hidden: false,
            label: { text: "Include de-designated appropriate bodies" }
          )
        %>
      <% end %>

      <%= f.govuk_submit "Search" %>
    <% end %>

    <% @appropriate_bodies.each do |appropriate_body| %>
      <%=
        govuk_summary_card(title: govuk_link_to(appropriate_body.name, admin_appropriate_body_path(appropriate_body))) do |card|
          card.with_summary_list do |summary_list|
            unless appropriate_body.active?
              summary_list.with_row do |row|
                row.with_key(text: "Status")
                row.with_value(text: govuk_tag(text: "De-designated", colour: "grey"))
              end
            end

            summary_list.with_row do |row|
              row.with_key(text: "Ongoing inductions")
              row.with_value(text: appropriate_body.induction_periods.unfinished.count)
            end
          end
        end
      %>
    <% end %>

    <%= render Shared::PaginationSummaryComponent.new(
      pagy: @pagy,
      record_name: "appropriate bodies"
    ) %>
  </div>
</div>
