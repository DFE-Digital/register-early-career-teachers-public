<% page_data(title: "New OAuth authorization request") %>

<% if authenticated? && !current_user.appropriate_body_user? %>
  <%= govuk_warning_text do %>
    You are signed in as <%= current_user.name %> (<%= current_user.dfe_user? ? "DfE #{role_name(current_user.role)}" : current_user.organisation_name %>).
    You must be signed in as an appropriate body user to start an authorization request.
    <%= govuk_link_to("Sign out", current_user.sign_out_path) %>
  <% end %>
<% end %>

<p class="govuk-body">
  Set the parameters for the GET /oauth/authorize request and start the OAuth journey.
</p>

<%= form_with(model: @api_client_connection, url: integration_support_api_client_connection_path) do |form| %>
  <%= govuk_summary_card(title: "Appropriate body") do %>
    <%= form.govuk_collection_select(:appropriate_body_period_id,
                                     @appropriate_body_periods,
                                     :id,
                                     :name,
                                     label: { text: "Appropriate body period ID" },
                                     hint: { text: "The ID of the appropriate body period. This must match the appropriate body you sign in as." }) %>

    <%= form.govuk_text_field(:response_type,
                              label: { text: "Response type" },
                              hint: { text: "The type of response to request from the authorization server." }) %>
  <% end %>

  <%= govuk_summary_card(title: "API client") do %>
    <%= form.govuk_select(:client_id,
                          [*@clients.pluck(:name, :client_id), ["Unknown client", "unknown-client-id"], ["Blank client", ""]],
                          label: { text: "Client ID" },
                          hint: { text: "The client identifier issued to the API client." }) %>

    <p class="govuk-body">
      <%= govuk_link_to("Create a test client", new_integration_support_api_client_path) %>
    </p>

    <%= form.govuk_text_field(:redirect_uri,
                              label: { text: "Redirect URI" },
                              hint: { text: "The URI to which the authorization server will redirect." }) %>

    <%= form.govuk_text_field(:state,
                              label: { text: "State" },
                              hint: { text: "A unique value used to maintain state between the request and the callback." }) %>  <% end %>

  <%= govuk_summary_card(title: "PKCE") do %>
    <%= form.govuk_text_field(:code_verifier,
                              label: { text: "Code verifier (PKCE)" },
                              hint: { text: "A high-entropy cryptographic random string." }) %>

    <%= form.govuk_collection_select(:code_challenge_method,
                                     API::OAuth::Authorization.code_challenge_methods.values + %w[plain],
                                     :to_s,
                                     :to_s,
                                     label: { text: "Code challenge method" },
                                     hint: { text: "The method used to generate the code challenge." }) %>

    <%= form.govuk_text_field(:code_challenge,
                              label: { text: "Code challenge (derived from code verifier)" },
                              hint: { text: "Computed using SHA-256 and base64url encoding. You can override this to test invalid values." }) %>  <% end %>

  <%= form.govuk_submit("Start authorization request") %>
<% end %>
