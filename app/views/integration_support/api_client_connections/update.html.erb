<% page_data(title: "Exchange authorization code", backlink_href: new_integration_support_api_client_connection_path) %>

<%= render("response") %>

<% if @response&.success? && @response.body.is_a?(Hash) && @response.body["access_token"].present? %>
  <p class="govuk-body">
    <%= govuk_link_to("Revoke access token", delete_integration_support_api_client_connection_path(access_token: @response.body["access_token"])) %>
  </p>
<% end %>
