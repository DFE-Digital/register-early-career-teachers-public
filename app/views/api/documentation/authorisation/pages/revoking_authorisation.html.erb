%>
<%
  page_data(
    title: "Revoking authorisation",
    error: false,
    caption: "API Developer documentation",
    caption_size: 'l'
  )
%>


<%= govuk_notification_banner(title_text: "Note") do %>
  <p>
  We need to add how an end user can do this once the journey is built
  </p>
<% end %>

<p class="govuk-body">
An authorisation can be revoked should the need arise, for example if the token was leaked.
</p>

<p class="govuk-body">
You revoke a token via a HTTP POST request to our revoke endpoint.
</p>

<p class="govuk-body">
You must authenticate the request with <%= govuk_link_to("HTTP Basic Authentication", "https://www.rfc-editor.org/info/rfc7617/") %>
using your client ID and secret.  This is added as a HTTP header in which you Base64 encode your credentials in the form <code>client_id:client_secret</code>.
</p>

<p class="govuk-body">
For example, if your client ID was <code>client123</code> and your secret was <code>supersecretvalue</code> then your Basic Authentication header would be this:
</p>

<pre>
<code>
Authorization: Basic Y2xpZW50MTIzOnN1cGVyc2VjcmV0dmFsdWU=
</code>
</pre>


<%= govuk_warning_text(text: "Do not include your client ID or client secret in the body of the request.") %>

<p class="govuk-body">
Include the other parameters in the request body, not as additional request headers.
</p>

<h3 class="govuk-heading-s">Example request</h3>

<pre>
<code>
curl -X POST <%= @api_base_url %>/oauth/revoke \
--user "client123:supersecretvalue" \
-H "content-type:application/x-www-form-urlencoded" \
--data "token=[ACCESS-TOKEN-TO-REVOKE]"
</code>
</pre>

<%= govuk_table do |table|
  table.with_head do |head|
    head.with_row do |row|
      row.with_cell(text: "Parameter")
      row.with_cell(text: "Description")
    end
  end
  table.with_body do |body|
    body.with_row do |row|
      row.with_cell(text: "token")
      row.with_cell(text: "The access token to be revoked")
    end
  end
end %>

<p class="govuk-body">
The successful response will be HTTP status 200 code with an empty body.  The access token will now be unusable.
</p>


<h3 class="govuk-heading-s">Error responses</h3>

<p class="govuk-body">
An unsuccessful request will a HTTP status error code and a JSON payload containing an <code>error</code> value, for example:
</p>

<pre>
<code>
{
  error: "invalid_client"
}
</code>
</pre>

<%= govuk_table do |table|
  table.with_head do |head|
    head.with_row do |row|
      row.with_cell(text: "Error scenario")
      row.with_cell(text: "HTTP status")
      row.with_cell(text: "Error")
    end
  end
  table.with_body do |body|
    body.with_row do |row|
      row.with_cell(text: "Client ID or client secret invalid")
      row.with_cell(text: "401 (Unauthorized)")
      row.with_cell(text: "invalid_client")
    end
  end
end %>

