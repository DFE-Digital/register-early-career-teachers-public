<% page_data(
  title: "Change school start date for #{@wizard.teacher_full_name}",
  error: @wizard.current_step.errors.present?,
  backlink_href: schools_ect_path(@wizard.ect_at_school_period)
) %>

<%= form_with(
      model: @wizard.current_step,
      url: @wizard.current_step_path
    ) do |form| %>
  <%= content_for(:error_summary) do %>
    <%= form.govuk_error_summary %>
  <% end %>

  <%= form.govuk_date_field(
        :start_date,
        width: "two-thirds",
        legend: {
          text: "School start date",
          size: "m"
        },
        hint: {
          text: "For example, 17 9 #{Date.current.year}"
        }
      ) %>

  <%= form.govuk_submit "Continue" %>

  <p class="govuk-body">
    <%= govuk_link_to(
          "Cancel and go back to #{@wizard.teacher_full_name}’s details",
          schools_ect_path(@wizard.ect_at_school_period),
          no_visited_state: true
        ) %>
  </p>
<% end %>
