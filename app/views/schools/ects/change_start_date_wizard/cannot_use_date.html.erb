<% page_data(
  title: "You cannot change #{@wizard.teacher_full_name}’s school start date " \
         "to #{@wizard.current_step.start_date.to_fs(:govuk)}",
  error: false
) %>

<p class="govuk-body">
  The date you’ve entered is for an academic year that is not open yet.
</p>

<p class="govuk-body">
  If you want to move <%= @wizard.teacher_full_name %> to this academic year,
  <%= govuk_link_to(
        "contact support",
        new_schools_support_query_path
      ) %>.
</p>

<p class="govuk-body">
  If you’ve made a mistake with the date,
  <%= govuk_link_to(
        "go back",
        @wizard.previous_step_path,
        no_visited_state: true
      ) %>
  and re-enter it.
</p>
